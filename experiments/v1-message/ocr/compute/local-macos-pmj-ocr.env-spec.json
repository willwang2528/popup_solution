{
  "base": "macOS 26.2 arm64 runtime + Command Line Tools Swift 6.3.2 + macOS 15.4 SDK + project Python 3.12.13",
  "system_pkgs": [],
  "pip_phases": [],
  "env": {
    "PYTHONHASHSEED": "0"
  },
  "build_commands": [
    "xcrun --sdk macosx15.4 swiftc -target arm64-apple-macosx15.4 -module-cache-path popup-solution/experiments/v1-message/ocr/.build/module-cache -O popup-solution/experiments/v1-message/ocr/vision_ocr.swift -o popup-solution/experiments/v1-message/ocr/.build/vision-ocr-b77d6b9d7694"
  ],
  "run_commands": [
    "PMJ_RUN_REAL_VISION=1 .venv/bin/python3 -m unittest discover -s popup-solution/experiments/v1-message/ocr/tests -v",
    ".venv/bin/python3 popup-solution/experiments/v1-message/ocr/run_ocr.py --manifest popup-solution/dataset-v1/work/annotation-media/pilot-batch-30/pilot-manifest.jsonl --media-root popup-solution/dataset-v1/work/annotation-media/pilot-batch-30 --output-dir popup-solution/experiments/v1-message/ocr/results/pilot-batch-30 --language zh-Hans --language en-US --recognition-level accurate --seed 17"
  ],
  "inputs": {
    "pilot_manifest": "popup-solution/dataset-v1/work/annotation-media/pilot-batch-30/pilot-manifest.jsonl",
    "pilot_manifest_sha256": "2df7c98d78787e880da28469c4face345b7d0b0185a463753b5c80717ff5aabf",
    "pilot_item_count": 30,
    "media_root": "popup-solution/dataset-v1/work/annotation-media/pilot-batch-30",
    "media_policy": "gitignored adapter-only local source; each screenshot SHA-256 is checked before OCR"
  },
  "artifacts": {
    "python_adapter": "popup-solution/experiments/v1-message/ocr/run_ocr.py",
    "python_adapter_sha256": "bf59d2c3001df4acd11b1ca4dcb06ca212a9ca94bc78de218c77d9c27d5245b2",
    "swift_source": "popup-solution/experiments/v1-message/ocr/vision_ocr.swift",
    "swift_source_sha256": "b77d6b9d7694e7c3ba816d20bd58ad9f3752fa3b58734e67895002b4c0e2096b",
    "private_predictions": "popup-solution/experiments/v1-message/ocr/results/pilot-batch-30/predictions.jsonl",
    "private_run_manifest": "popup-solution/experiments/v1-message/ocr/results/pilot-batch-30/run_manifest.json",
    "public_summary": "popup-solution/experiments/v1-message/ocr/PUBLIC_RUN_SUMMARY.json"
  },
  "ocr_config": {
    "framework": "Vision",
    "request": "VNRecognizeTextRequest",
    "request_revision": 3,
    "recognition_level": "accurate",
    "languages": [
      "zh-Hans",
      "en-US"
    ],
    "uses_language_correction": true,
    "seed": 17,
    "seed_semantics": "pipeline witness only; Vision OCR performs no stochastic sampling"
  },
  "resource_caps": {
    "hardware_or_ml_gpu_hours": 0,
    "paid_experiment_api_usd": 0,
    "external_experiment_network": false,
    "real_irreversible_gui_actions": 0,
    "max_runtime_seconds": 900,
    "input_images": 30,
    "automatic_retries": 0
  },
  "smoke": {
    "import_names": [],
    "cli_checks": [
      "xcrun swiftc --version",
      "xcrun --sdk macosx15.4 --show-sdk-version"
    ],
    "kernel_tests": [
      {
        "cmd": "popup-solution/experiments/v1-message/ocr/.build/vision-ocr-b77d6b9d7694 --witness --seed 17 --language en-US",
        "expect": "^WITNESS vision_ocr seed=17 observations=[0-9]+ revision=3$"
      }
    ]
  },
  "operator_contract": {
    "fresh_agent_required": true,
    "no_online_or_paid_api": true,
    "no_device_action": true,
    "forbidden_manifest_inputs": [
      "source_sampling_label",
      "popup_present_gt",
      "any gold field"
    ],
    "private_text_policy": "raw images and derived OCR text stay gitignored pending privacy review",
    "on_build_or_runtime_failure": "BLOCK_WITHOUT_PREDICTIONS"
  }
}
