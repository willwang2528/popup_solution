    },
    {
      "version": "1.0.2",
      "timestamp_utc": "2026-09-01T00:28:00Z",
      "reason": "Operationalize screenshot-only popup scope with observable include/exclude and edge-case rules. Dismissibility is explicitly not inferred. No annotation fields, media bytes, thresholds, or human outputs changed.",
      "human_outputs_present_at_amendment": false
    },
    {
      "version": "1.0.3",
      "timestamp_utc": "2026-09-01T00:37:00Z",
      "reason": "Fail closed when G2 auditors detect a substantive error in frozen G1 screenshot-message gold. The item becomes cannot_resolve and must restart from a versioned G1 correction; no method output may influence the correction. No human outputs exist.",
      "human_outputs_present_at_amendment": false
    },
    {
      "version": "1.0.4",
      "timestamp_utc": "2026-09-01T00:43:11Z",
      "reason": "Represent predefined scope exclusions explicitly as out_of_scope with a mandatory machine-readable reason, and operationalize visual separability without temporal or dismissibility inference. Out-of-scope items are resolved but never metric eligible. No human outputs exist.",
      "human_outputs_present_at_amendment": false
    },
    {
      "version": "1.0.5",
      "timestamp_utc": "2026-09-01T00:49:21Z",
      "reason": "Clarify the user-specified V1 boundary: permission_security_control includes both OS-level permission dialogs and app-internal permission or security controls. This removes an annotation ambiguity without changing fields, media, thresholds, or human outputs.",
      "human_outputs_present_at_amendment": false
    },
    {
      "version": "1.0.6",
      "timestamp_utc": "2026-09-01T00:55:25Z",
      "reason": "Expand Git ignore coverage for every private or text-bearing annotation, feature, OCR, pregold, statistics, and pending-union work root before public synchronization. No protocol field, media byte, threshold, or human output changed.",
      "human_outputs_present_at_amendment": false
    },
    {
      "version": "1.0.7",
      "timestamp_utc": "2026-09-01T00:57:05Z",
      "reason": "Withhold item-level AI preannotation JSONL because it contains screenshot-derived third-party message text that has not passed privacy review. Aggregate non-text summaries remain publishable. No protocol field, media byte, threshold, or human output changed.",
      "human_outputs_present_at_amendment": false
