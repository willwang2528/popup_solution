{
  "contract_id": "PMAB-ANDROID-CAPTURE-V1",
  "contract_revision": "1.1.2",
  "capture_schema_version": "1.1.0",
  "legacy_capture_schema_version": "1.0.0",
  "scope": "capture feasibility for action-free popup presence and message research",
  "formal_input_anchor": "synchronized Android screenshot plus AccessibilityService node snapshot",
  "required_observation_phase": "pre_action",
  "required_action_attempts": [],
  "maximum_synchronization_delta_ms": 3000,
  "synchronization_clock": "android.os.SystemClock.uptimeMillis",
  "required_capture_order": [
    "tree_before",
    "screenshot",
    "tree_after"
  ],
  "stable_state_requirements": {
    "canonical_tree_hash_must_match": true,
    "offline_finalizer_must_recompute_canonical_tree_hash": true,
    "canonical_value_encoding": "explicit_null_or_utf8_string_type_tag",
    "offline_finalizer_must_validate_collector_value_domains_and_paths": true,
    "offline_finalizer_must_recompute_target_packages_and_focus_token": true,
    "accessibility_event_sequence_must_match": true,
    "focus_token_must_match": true,
    "tree_must_not_be_truncated": true,
    "sensitive_node_must_be_absent": true
  },
  "offline_verification_boundary": "API-34 accessibility-data-sensitive state has no per-node serialized field and remains collector-reported plus source/process audited; it is not independently recomputable offline",
  "required_collector_mode": "accessibilityservice_node_snapshot",
  "required_strata": [
    "popup_candidate",
    "no_popup_candidate",
    "boundary_candidate"
  ],
  "minimum_source_groups": 5,
  "minimum_popup_template_families": 3,
  "aggregate_input_must_be_private_bundles": true,
  "aggregate_command_refinalizes_private_bundles": true,
  "aggregate_command_accepts_record_only_input": false,
  "duplicate_policy": {
    "capture_id": "reject",
    "screenshot_sha256": "reject",
    "accessibility_snapshot_sha256": "reject"
  },
  "authorization_gate": {
    "collection_authorized": true,
    "privacy_review_status": "passed",
    "allowed_redistribution_status": [
      "public_media",
      "adapter_only"
    ]
  },
  "private_inputs": [
    "request metadata",
    "collector machine record",
    "host collector APK attestation",
    "separate human review record",
    "screenshot",
    "raw accessibility tree before screenshot",
    "raw accessibility tree after screenshot"
  ],
  "public_record_allowlist": [
    "capture and item identifiers",
    "group, template-family and intended-stratum identifiers",
    "collector mode",
    "authorization status",
    "synchronization result",
    "artifact SHA-256 and byte counts",
    "window and node counts",
    "negative eligibility assertions"
  ],
  "forbidden_at_this_gate": [
    "dismissal or any other action",
    "human-gold labels",
    "method predictions",
    "raw screenshot or accessibility text in the public record",
    "paper metrics",
    "user-experience or recovery claims"
  ],
  "success_status": "ready_for_real_g1_pilot",
  "paper_result_eligible": false,
  "human_gold_count": 0,
  "next_gate": "independent_blinded_g1_annotation"
}
